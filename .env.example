# Non-secret league configuration (required)
ESPN_LEAGUE_ID=replace_with_league_id
ESPN_SEASON=2026

# Private-league credentials (optional as a pair for setup validation;
# later ESPN audit commands may require them).
ESPN_S2=
ESPN_SWID=

# Logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO

# Private local SQLite snapshot store
SNAPSHOT_DB_PATH=outputs/fantasy_football.sqlite3
