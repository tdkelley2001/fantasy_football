ESPN_LEAGUE_ID=YOUR_LEAGUE_ID
ESPN_SEASON=2026

# Required for private leagues
ESPN_S2=YOUR_ESPN_S2_COOKIE
ESPN_SWID={YOUR_SWID_COOKIE}

# Baseline output folder
ESPN_OUTPUT_DIR=league_projection_output

# Trade search: use teams.csv to identify your ESPN team_id
MY_TEAM_ID=YOUR_TEAM_ID

# Optional trade search settings
TRADE_TOP_N_PER_TYPE=100
TRADE_MIN_AVG_WEEKLY_GAIN=0.50

# Re-run standings/playoffs for every valid exact trade.
TRADE_REPROJECT_ALL=true
